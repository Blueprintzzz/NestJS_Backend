generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── User ────────────────────────────────────────────────────────────────────

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  phone         String?
  role          UserRole       @default(TOURIST)
  status        UserStatus     @default(ACTIVE)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  driverProfile DriverProfile?
  refreshTokens RefreshToken[]
  vehicles      Vehicle[]
  driverOffers  DriverOffer[]
  customBookings CustomBooking[]

  @@index([email])
  @@index([role])
  @@index([status])
}

model DriverProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  licenseNumber String   @unique
  licenseExpiry DateTime
  experience    Int      @default(0)
  bio           String?  @db.Text
  rating        Decimal? @db.Decimal(3, 2)
  totalTrips    Int      @default(0)
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── Vehicle Model ───────────────────────────────────────────────────────────

model VehicleModel {
  id             String          @id @default(uuid())
  name           String          @unique
  type           VehicleType
  vehicles       Vehicle[]
  customBookings CustomBooking[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([type])
}

// ─── Vehicle ─────────────────────────────────────────────────────────────────

model Vehicle {
  id                 String                @id @default(uuid())
  driverId           String
  driver             User                  @relation(fields: [driverId], references: [id])
  vehicleModelId     String
  vehicleModel       VehicleModel          @relation(fields: [vehicleModelId], references: [id])
  type               VehicleType
  capacity           Int
  pricePerDay        Decimal               @db.Decimal(10, 2)
  images             Json                  @default("[]")
  features           Json                  @default("[]")
  status             ResourceStatus        @default(ACTIVE)
  description        String?
  registrationNumber String                @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  availability       VehicleAvailability[]
  bookings           Booking[]
  driverOffers       DriverOffer[]

  @@index([driverId])
  @@index([vehicleModelId])
  @@index([type])
  @@index([status])
}

model VehicleAvailability {
  id                String   @id @default(uuid())
  vehicleId         String
  date              DateTime @db.Date
  isAvailable       Boolean  @default(true)
  bookedByBookingId String?
  booking           Booking? @relation(fields: [bookedByBookingId], references: [id])
  vehicle           Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@unique([vehicleId, date])
  @@index([vehicleId])
  @@index([date])
  @@index([bookedByBookingId])
}

// ─── Booking ─────────────────────────────────────────────────────────────────

model Booking {
  id                 String             @id @default(uuid())
  bookingNumber      String             @unique
  userId             String
  tourPackageId      String
  vehicleId          String?
  startDate          DateTime
  endDate            DateTime
  numberOfPassengers Int
  totalCost          Decimal            @db.Decimal(10, 2)
  advancePayment     Decimal?           @db.Decimal(10, 2)
  remainingAmount    Decimal            @db.Decimal(10, 2)
  status             BookingStatus      @default(PENDING)
  paymentStatus      PaymentStatus      @default(NOT_PAID)
  specialRequests    String?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  passengers           BookingPassenger[]
  payments             BookingPayment[]
  reviews              Review[]
  vehicleAvailability  VehicleAvailability[]
  tourPackage          TourPackage        @relation(fields: [tourPackageId], references: [id])
  vehicle              Vehicle?           @relation(fields: [vehicleId], references: [id])

  @@index([userId])
  @@index([tourPackageId])
  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

model BookingPassenger {
  id             String   @id @default(uuid())
  bookingId      String
  passengerName  String
  email          String
  phone          String
  dateOfBirth    DateTime
  passportNumber String?
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingPayment {
  id            String                   @id @default(uuid())
  bookingId     String
  amount        Decimal                  @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime
  transactionId String?
  status        PaymentTransactionStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  booking       Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─── Tour Package ───────────────────────────────────────────────────────────

model TourPackage {
  id               String                @id @default(uuid())
  name             String
  description      String
  category         PackageCategory
  duration         Int
  basePrice        Decimal               @db.Decimal(10, 2)
  highlights       Json                  @default("[]")
  bestSeason       String
  maxCapacity      Int
  images           Json                  @default("[]")
  status           ResourceStatus        @default(ACTIVE)
  featured         Boolean               @default(false)
  adminId          String
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  destinationId    String?
  itineraries      PackageItinerary[]
  inclusions       PackageInclusion[]
  bookings         Booking[]

  @@index([category])
  @@index([status])
}

model PackageItinerary {
  id              String      @id @default(uuid())
  packageId       String
  day             Int
  title           String
  description     String
  attractions     String
  airportPickup   Boolean     @default(false)
  airportDropoff  Boolean     @default(false)
  package         TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, day])
  @@index([packageId])
}

model PackageInclusion {
  id        String        @id @default(uuid())
  packageId String
  inclusion String
  type      InclusionType
  package   TourPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

// ─── Review ─────────────────────────────────────────────────────────────────

model Review {
  id          String       @id @default(uuid())
  bookingId   String
  userId      String
  rating      Int
  title       String
  description String
  images      Json         @default("[]")
  status      ReviewStatus @default(PENDING)
  helpful     Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  booking     Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([bookingId])
}

// ─── Inquiry ─────────────────────────────────────────────────────────────────

model Inquiry {
  id                String            @id @default(uuid())
  name              String
  email             String
  phone             String
  subject           String
  message           String
  status            InquiryStatus     @default(NEW)
  priority          InquiryPriority   @default(MEDIUM)
  category          InquiryCategory
  assignedToAdminId String?
  respondedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  responses         InquiryResponse[]

  @@index([status])
  @@index([priority])
  @@index([category])
}

model InquiryResponse {
  id                 String   @id @default(uuid())
  inquiryId          String
  respondedByAdminId String
  response           String
  createdAt          DateTime @default(now())
  inquiry            Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

// ─── Destination ─────────────────────────────────────────────────────────────

model Destination {
  id                    String              @id @default(cuid())
  name                  String              @unique
  description           String              @db.Text
  category              DestinationCategory
  district              String?
  images                Json                @default("[]")
  coverImage            String?
  latitude              Decimal             @db.Decimal(10, 8)
  longitude             Decimal             @db.Decimal(11, 8)
  weatherInfo           Json?
  bestVisitingSeason    String?
  travelTips            String?             @db.Text
  estimatedVisitingTime String?
  openingHours          String?
  entryFee              Decimal?            @db.Decimal(10, 2)
  featured              Boolean             @default(false)
  status                String              @default("ACTIVE")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  experiences           Experience[]

  @@index([category])
  @@index([featured])
  @@index([status])
  @@index([district])
}

// ─── Experience ─────────────────────────────────────────────────────────────

model Experience {
  id          String             @id @default(cuid())
  name        String
  description String             @db.Text
  category    ExperienceCategory
  price       Decimal            @db.Decimal(10, 2)
  duration    String
  image       String?
  images      Json               @default("[]")
  location      String?
  destinationId String?
  destination   Destination?       @relation(fields: [destinationId], references: [id])
  featured      Boolean            @default(false)
  status      String             @default("ACTIVE")
  rating      Decimal?           @db.Decimal(3, 2)
  reviewCount Int?               @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([category])
  @@index([featured])
}

// ─── Custom Booking ──────────────────────────────────────────────────────────

model CustomBooking {
  id                   String              @id @default(uuid())
  bookingNumber        String              @unique
  userId               String
  user                 User                @relation(fields: [userId], references: [id])
  title                String
  description          String              @db.Text
  startDate            DateTime
  endDate              DateTime
  numberOfPeople       Int
  budget               Decimal?            @db.Decimal(10, 2)
  pickupLocation       String
  dropoffLocation      String
  requestedVehicleType VehicleType
  requestedModelId     String?
  requestedModel       VehicleModel?       @relation(fields: [requestedModelId], references: [id])
  destinations         Json                @default("[]")
  requirements         String?             @db.Text
  status               CustomBookingStatus @default(PENDING)
  selectedOfferId      String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  offers               DriverOffer[]

  @@index([userId])
  @@index([status])
  @@index([requestedVehicleType])
}

model DriverOffer {
  id              String        @id @default(uuid())
  customBookingId String
  customBooking   CustomBooking @relation(fields: [customBookingId], references: [id], onDelete: Cascade)
  driverId        String
  driver          User          @relation(fields: [driverId], references: [id])
  vehicleId       String
  vehicle         Vehicle       @relation(fields: [vehicleId], references: [id])
  price           Decimal       @db.Decimal(10, 2)
  message         String?       @db.Text
  eta             String?
  status          OfferStatus   @default(PENDING)
  validUntil      DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([customBookingId])
  @@index([driverId])
  @@index([vehicleId])
  @@index([status])
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum DestinationCategory {
  TEMPLE
  BEACH
  MOUNTAIN
  WATERFALL
  HISTORIC
  WILDLIFE
  CITY
  NATURE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  NOT_PAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  ONLINE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum PackageCategory {
  ADVENTURE
  NATURE
  ROMANTIC
  WILDLIFE
  FAMILY
  CULTURAL
  BEACH
  LUXURY
}

enum InclusionType {
  MEAL
  TRANSPORT
  ACCOMMODATION
  ACTIVITY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
}

enum InquiryCategory {
  BOOKING
  GENERAL
  COMPLAINT
  SUGGESTION
}

enum VehicleType {
  CAR
  SUV
  VAN
  MINIBUS
  LUXURY
}

enum ExperienceCategory {
  ADVENTURE
  NATURE
  CULTURAL
  RELAXATION
  FAMILY
  ROMANTIC
}

enum UserRole {
  TOURIST
  DRIVER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum CustomBookingStatus {
  PENDING
  OFFER_RECEIVED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}
