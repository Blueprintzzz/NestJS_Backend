generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
}

model Example {
  id          String   @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id                 String               @id @default(uuid())
  bookingNumber      String               @unique
  userId             String
  tourPackageId      String
  vehicleId          String?
  startDate          DateTime
  endDate            DateTime
  numberOfPassengers Int
  totalCost          Decimal              @db.Decimal(10, 2)
  advancePayment     Decimal?             @db.Decimal(10, 2)
  remainingAmount    Decimal              @db.Decimal(10, 2)
  status             BookingStatus        @default(PENDING)
  paymentStatus      PaymentStatus        @default(NOT_PAID)
  specialRequests    String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  passengers         BookingPassenger[]
  payments           BookingPayment[]
  reviews            Review[]
  vehicleAvailability VehicleAvailability[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model BookingPassenger {
  id             String   @id @default(uuid())
  bookingId      String
  passengerName  String
  email          String
  phone          String
  dateOfBirth    DateTime
  passportNumber String?
  createdAt      DateTime @default(now())
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model BookingPayment {
  id            String                   @id @default(uuid())
  bookingId     String
  amount        Decimal                  @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  paymentDate   DateTime
  transactionId String?
  status        PaymentTransactionStatus @default(PENDING)
  createdAt     DateTime                 @default(now())
  booking       Booking                  @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

// ─── Tour Package ───────────────────────────────────────────────────────────

model TourPackage {
  id           String              @id @default(uuid())
  name         String
  description  String
  category     PackageCategory
  duration     Int
  basePrice    Decimal             @db.Decimal(10, 2)
  highlights   Json                @default("[]")
  bestSeason   String
  maxCapacity  Int
  images       Json                @default("[]")
  status       ResourceStatus      @default(ACTIVE)
  featured     Boolean             @default(false)
  adminId      String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  itineraries  PackageItinerary[]
  inclusions   PackageInclusion[]

  @@index([category])
  @@index([status])
}

model PackageItinerary {
  id          String      @id @default(uuid())
  packageId   String
  day         Int
  title       String
  description String
  attractions String
  package     TourPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, day])
  @@index([packageId])
}

model PackageInclusion {
  id        String        @id @default(uuid())
  packageId String
  inclusion String
  type      InclusionType
  package   TourPackage   @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

// ─── Review ─────────────────────────────────────────────────────────────────

model Review {
  id          String        @id @default(uuid())
  bookingId   String
  userId      String
  rating      Int
  title       String
  description String
  images      Json          @default("[]")
  status      ReviewStatus  @default(PENDING)
  helpful     Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  booking     Booking       @relation(fields: [bookingId], references: [id])

  @@index([userId])
  @@index([status])
  @@index([bookingId])
}

// ─── Inquiry ─────────────────────────────────────────────────────────────────

model Inquiry {
  id                String            @id @default(uuid())
  name              String
  email             String
  phone             String
  subject           String
  message           String
  status            InquiryStatus     @default(NEW)
  priority          InquiryPriority   @default(MEDIUM)
  category          InquiryCategory
  assignedToAdminId String?
  respondedAt       DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  responses         InquiryResponse[]

  @@index([status])
  @@index([priority])
  @@index([category])
}

model InquiryResponse {
  id                  String   @id @default(uuid())
  inquiryId           String
  respondedByAdminId  String
  response            String
  createdAt           DateTime @default(now())
  inquiry             Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId])
}

// ─── Vehicle ─────────────────────────────────────────────────────────────────

model Vehicle {
  id                 String                @id @default(uuid())
  name               String
  type               VehicleType
  capacity           Int
  pricePerDay        Decimal               @db.Decimal(10, 2)
  images             Json                  @default("[]")
  features           Json                  @default("[]")
  status             ResourceStatus        @default(ACTIVE)
  description        String?
  registrationNumber String                @unique
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  availability       VehicleAvailability[]

  @@index([type])
  @@index([status])
}

model VehicleAvailability {
  id              String   @id @default(uuid())
  vehicleId       String
  date            DateTime @db.Date
  isAvailable     Boolean  @default(true)
  bookedByBookingId String?
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  booking         Booking? @relation(fields: [bookedByBookingId], references: [id])

  @@unique([vehicleId, date])
  @@index([vehicleId])
  @@index([date])
}

// ─── Map / District / Attraction ─────────────────────────────────────────────

model District {
  id                 String       @id @default(cuid())
  name               String       @unique
  description        String       @db.Text
  weatherInfo        Json
  bestVisitingSeason String?
  latitude           Decimal      @db.Decimal(10, 8)
  longitude          Decimal      @db.Decimal(11, 8)
  coverImage         String?
  featured           Boolean      @default(false)
  status             String       @default("ACTIVE")
  attractions        Attraction[]
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([featured])
}

model Attraction {
  id                    String   @id @default(cuid())
  districtId            String
  district              District @relation(fields: [districtId], references: [id], onDelete: Cascade)
  name                  String
  description           String   @db.Text
  category              String
  images                Json     @default("[]")
  travelTips            String   @db.Text
  estimatedVisitingTime String
  latitude              Decimal  @db.Decimal(10, 8)
  longitude             Decimal  @db.Decimal(11, 8)
  openingHours          String?
  entryFee              Decimal  @db.Decimal(10, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([districtId])
  @@index([category])
}

model TourCategory {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @db.Text
  icon        String?
  color       String?
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentStatus {
  NOT_PAID
  PARTIAL
  PAID
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  CASH
  ONLINE
}

enum PaymentTransactionStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ResourceStatus {
  ACTIVE
  INACTIVE
}

enum PackageCategory {
  ADVENTURE
  NATURE
  ROMANTIC
  WILDLIFE
  FAMILY
  CULTURAL
  BEACH
  LUXURY
}

enum InclusionType {
  MEAL
  TRANSPORT
  ACCOMMODATION
  ACTIVITY
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InquiryStatus {
  NEW
  RESPONDED
  CLOSED
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
}

enum InquiryCategory {
  BOOKING
  GENERAL
  COMPLAINT
  SUGGESTION
}

enum VehicleType {
  CAR
  SUV
  VAN
  MINIBUS
  LUXURY
}

